-- When you do "ALTER ROLE ... PASSWORD '...';" manually in psql,
-- password goes to log files, psql/bash history files, AWS logfiles, etc.
-- This is insecure.
-- This interactive script solves this problem.

-- The password is generated on the server from gen_random_uuid(), which uses
-- the cryptographically strong pg_strong_random() source (PostgreSQL 13+).
-- It is never included in a server message (RAISE) and is printed only by
-- psql, once, at the end of this script.

-- The final attributes always match the answers: answering "no" removes
-- SUPERUSER / LOGIN from a role that had them. NOSUPERUSER is emitted only for
-- a role that is currently a superuser, because PostgreSQL reserves any
-- SUPERUSER clause for superusers; this keeps password rotation of ordinary
-- roles available to CREATEROLE operators.

-- Usage (run in psql):
--     \i /path/to/PostgresDBA/roles/alter_user_with_random_password.psql

\prompt "Username?" postgres_dba_username
\prompt "Superuser? (yes/no)" postgres_dba_is_superuser
\prompt "Login? (yes/no)" postgres_dba_login

begin;

\o /dev/null
select set_config('postgres_dba.username', :'postgres_dba_username', true);
select set_config('postgres_dba.is_superuser', :'postgres_dba_is_superuser', true);
select set_config('postgres_dba.login', :'postgres_dba_login', true);
\o

do $$
declare
  username text := current_setting('postgres_dba.username');
  answers text[] := array[
    lower(trim(current_setting('postgres_dba.is_superuser'))),
    lower(trim(current_setting('postgres_dba.login')))
  ];
  flags boolean[] := array[]::boolean[];
  answer text;
  allowed constant text := '23456789abcdefghjkmnpqrstuvwxyzABCDEFGHJKMNPQRSTUVWXYZ';
  random_bytes bytea;
  b int4;
  pwd text := '';
  is_superuser boolean;
begin
  if username = '' then
    raise exception 'Username is not specified.';
  end if;

  select rolsuper into is_superuser from pg_roles where rolname = username;
  if not found then
    raise exception 'Role "%" does not exist; nothing was changed.', username;
  end if;

  foreach answer in array answers loop
    if answer in ('1', 'y', 'yes', 't', 'true', 's', 'sim') then
      flags := flags || true;
    elsif answer in ('0', 'n', 'no', 'f', 'false', 'nao', 'não') then
      flags := flags || false;
    else
      raise exception 'Invalid answer "%". Use yes or no; nothing was changed.', answer;
    end if;
  end loop;

  -- Rejection sampling over random bytes keeps every character equally likely.
  -- Bytes 6 and 8 of a UUID carry version/variant bits and are skipped.
  while length(pwd) < 16 loop
    random_bytes := uuid_send(gen_random_uuid());
    for i in 0..15 loop
      continue when i in (6, 8);
      b := get_byte(random_bytes, i);
      if b < 4 * length(allowed) and length(pwd) < 16 then
        pwd := pwd || substr(allowed, b % length(allowed) + 1, 1);
      end if;
    end loop;
  end loop;

  begin
    execute format(
      'alter role %I with %s %s password %L',
      username,
      case when flags[1] then 'superuser' when is_superuser then 'nosuperuser' else '' end,
      case when flags[2] then 'login' else 'nologin' end,
      pwd
    );
  exception when others then
    -- Re-raise without the failed statement, which contains the password,
    -- so that it never reaches the client or the server log as CONTEXT.
    raise exception using errcode = sqlstate, message = sqlerrm;
  end;

  -- Transaction-local: read by psql below and discarded at commit.
  perform set_config('postgres_dba.generated_password', pwd, true);
end;
$$ language plpgsql;

\if :ERROR
  rollback;
  \echo 'No changes were made.'
\else
  select
    current_setting('postgres_dba.username') as postgres_dba_altered_role,
    current_setting('postgres_dba.generated_password') as postgres_dba_generated_password
  \gset
  commit;
  \echo Role :postgres_dba_altered_role altered. Password (shown only once): :postgres_dba_generated_password
\endif

\unset postgres_dba_username
\unset postgres_dba_is_superuser
\unset postgres_dba_login
\unset postgres_dba_altered_role
\unset postgres_dba_generated_password
